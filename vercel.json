{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/edicao-magnetica",
      "destination": "/api/portao"
    },
    {
      "source": "/edicao-magnetica/aulas",
      "destination": "/api/area"
    },
    {
      "source": "/edicao-magnetica/baixar",
      "destination": "/api/baixar"
    }
  ],
  "functions": {
    "api/area.js": {
      "includeFiles": "api/_privado/**"
    },
    "api/baixar.js": {
      "includeFiles": "api/_privado/**"
    },
    "api/portao.js": {
      "includeFiles": "api/_privado/portao.html"
    }
  },
  "headers": [
    {
      "source": "/assets/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/edicao-magnetica(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "oferta"
        }
      ],
      "destination": "/edicao-ia",
      "permanent": false
    },
    {
      "source": "/vsl",
      "destination": "/edicao-ia",
      "permanent": false
    },
    {
      "source": "/skill",
      "destination": "/edicao-ia",
      "permanent": false
    }
  ]
}